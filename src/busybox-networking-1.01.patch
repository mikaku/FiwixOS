diff -ru busybox-1.01/Rules.mak busybox-1.01.new/Rules.mak
--- busybox-1.01/Rules.mak	2005-08-17 01:29:17 +0000
+++ busybox-1.01.new/Rules.mak	2026-10-13 17:36:41 +0000
@@ -35,7 +35,7 @@
 # by asking the CC compiler what arch it compiles things for, so unless
 # your compiler is broken, you should not need to specify TARGET_ARCH
 CROSS           =$(subst ",, $(strip $(CROSS_COMPILER_PREFIX)))
-CC             = $(CROSS)gcc
+CC             = $(CROSS)musl-gcc
 AR             = $(CROSS)ar
 AS             = $(CROSS)as
 LD             = $(CROSS)ld
@@ -49,7 +49,7 @@
 TARGET_OS=linux
 
 # Select the compiler needed to build binaries for your development system
-HOSTCC    = gcc
+HOSTCC    = musl-gcc
 HOSTCFLAGS= -Wall -Wstrict-prototypes -O2 -fomit-frame-pointer
 
 # Ensure consistent sort order, 'gcc -print-search-dirs' behavior, etc.
diff -ru busybox-1.01/applets/install.sh busybox-1.01.new/applets/install.sh
--- busybox-1.01/applets/install.sh	2005-08-17 01:29:16 +0000
+++ busybox-1.01.new/applets/install.sh	2026-10-13 17:36:41 +0000
@@ -16,28 +16,28 @@
 h=`sort busybox.links | uniq`
 
 
-rm -f $prefix/bin/busybox || exit 1
+rm -f $prefix/bin/busybox-networking || exit 1
 mkdir -p $prefix/bin || exit 1
-install -m 755 busybox $prefix/bin/busybox || exit 1
+install -m 755 busybox $prefix/bin/busybox-networking || exit 1
 
 for i in $h ; do
 	appdir=`dirname $i`
 	mkdir -p $prefix/$appdir || exit 1
 	if [ "$2" = "--hardlinks" ]; then
-	    bb_path="$prefix/bin/busybox"
+	    bb_path="$prefix/bin/busybox-networking"
 	else
 	    case "$appdir" in
 		/)
-		    bb_path="bin/busybox"
+		    bb_path="bin/busybox-networking"
 		;;
 		/bin)
-		    bb_path="busybox"
+		    bb_path="busybox-networking"
 		;;
 		/sbin)
-		    bb_path="../bin/busybox"
+		    bb_path="../bin/busybox-networking"
 		;;
 		/usr/bin|/usr/sbin)
-		    bb_path="../../bin/busybox"
+		    bb_path="../../bin/busybox-networking"
 		;;
 		*)
 		echo "Unknown installation directory: $appdir"
