diff -ru e2fsprogs-1.41.14/lib/blkid/llseek.c e2fsprogs-1.41.14.new/lib/blkid/llseek.c
--- e2fsprogs-1.41.14/lib/blkid/llseek.c	2009-08-13 01:39:57 +0000
+++ e2fsprogs-1.41.14.new/lib/blkid/llseek.c	2026-10-24 17:23:24 +0000
@@ -123,19 +123,31 @@
 #endif
 #endif
 
-blkid_loff_t blkid_llseek(int fd, blkid_loff_t offset, int origin)
+static blkid_loff_t my_llseek (int fd, blkid_loff_t offset, int origin)
 {
-#if defined(HAVE_LSEEK64) && defined(HAVE_LSEEK64_PROTOTYPE)
-	return lseek64 (fd, offset, origin);
-#else
-	if ((sizeof(off_t) < sizeof(blkid_loff_t)) &&
-	    (offset >= ((blkid_loff_t) 1 << ((sizeof(off_t)*8) - 1)))) {
-		errno = EOVERFLOW;
-		return -1;
-	}
-	return lseek(fd, (off_t) offset, origin);
-#endif
+	blkid_loff_t result;
+	int retval;
+
+	retval = llseek(fd, (unsigned long long) (offset >> 32),
+			  ((unsigned long long) offset) & 0xffffffff,
+			&result, origin);
+	return (retval == -1 ? (blkid_loff_t) retval : result);
 }
+blkid_loff_t blkid_llseek (int fd, blkid_loff_t offset, int origin)
+{
+	blkid_loff_t result;
+
+	if ((sizeof(off_t) >= sizeof(blkid_loff_t)) ||
+	    (offset < ((blkid_loff_t) 1 << ((sizeof(off_t)*8) -1))))
+		return lseek(fd, (off_t) offset, origin);
+
+	result = my_llseek (fd, offset, origin);
+	if (result == -1 && errno == ENOSYS) {
+ 		errno = EINVAL;
+ 	}
+	return result;
+}
+
 
 #endif	/* linux */
 
